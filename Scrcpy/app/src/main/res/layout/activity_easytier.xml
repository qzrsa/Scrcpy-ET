<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background"
  android:fitsSystemWindows="true"
  android:orientation="vertical"
  tools:context=".easytier.EasyTierActivity">

  <ImageView
    android:id="@+id/back_button"
    android:layout_width="54dp"
    android:layout_height="54dp"
    android:padding="15dp"
    android:src="@drawable/chevron_left"
    android:tint="@color/onBackground" />

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="15dp"
      android:paddingEnd="15dp">

      <!-- 开启开关 -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_cron"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingEnd="15dp"
        android:paddingBottom="10dp"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/easytier_enable"
            android:textColor="@color/onCardBackground"
            android:textSize="@dimen/middleFont" />

          <Switch
            android:id="@+id/switch_enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="@color/button"
            android:trackTint="@color/button" />
        </LinearLayout>

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="@string/easytier_enable_detail"
          android:textColor="@color/onCardBackgroundSecond"
          android:textSize="@dimen/smallSmallFont" />
      </LinearLayout>

      <!-- 配置区域 -->
      <LinearLayout
        android:id="@+id/config_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@drawable/background_cron"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingEnd="15dp"
        android:paddingBottom="10dp">

        <!-- 连接密码 -->
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/easytier_secret"
          android:textColor="@color/onCardBackground"
          android:textSize="@dimen/middleFont" />

        <EditText
          android:id="@+id/edit_secret"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/easytier_secret_hint"
          android:textColor="@color/onCardBackground"
          android:textColorHint="@color/onCardBackgroundSecond"
          android:textSize="@dimen/smallFont" />

        <!-- 网络名称 -->
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="@string/easytier_network_name"
          android:textColor="@color/onCardBackground"
          android:textSize="@dimen/middleFont" />

        <EditText
          android:id="@+id/edit_network_name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/easytier_network_name_hint"
          android:textColor="@color/onCardBackground"
          android:textColorHint="@color/onCardBackgroundSecond"
          android:textSize="@dimen/smallFont" />

        <!-- 端口 -->
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="@string/easytier_port"
          android:textColor="@color/onCardBackground"
          android:textSize="@dimen/middleFont" />

        <EditText
          android:id="@+id/edit_port"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:digits="0123456789"
          android:hint="@string/easytier_port_hint"
          android:textColor="@color/onCardBackground"
          android:textColorHint="@color/onCardBackgroundSecond"
          android:textSize="@dimen/smallFont" />

        <!-- 公网节点开关 -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:gravity="center"
          android:orientation="horizontal">

          <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/easytier_use_public"
            android:textColor="@color/onCardBackground"
            android:textSize="@dimen/middleFont" />

          <Switch
            android:id="@+id/switch_public"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="@color/button"
            android:trackTint="@color/button" />
        </LinearLayout>

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="@string/easytier_use_public_detail"
          android:textColor="@color/onCardBackgroundSecond"
          android:textSize="@dimen/smallSmallFont" />

        <!-- 服务器地址 -->
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="@string/easytier_server"
          android:textColor="@color/onCardBackground"
          android:textSize="@dimen/middleFont" />

        <EditText
          android:id="@+id/edit_server"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/easytier_server_hint"
          android:textColor="@color/onCardBackground"
          android:textColorHint="@color/onCardBackgroundSecond"
          android:textSize="@dimen/smallFont" />

        <!-- 保存按钮 -->
        <Button
          android:id="@+id/btn_save"
          android:layout_width="150dp"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginTop="15dp"
          android:background="@drawable/background_cron"
          android:backgroundTint="@color/button"
          android:gravity="center"
          android:text="@string/device_button"
          android:textColor="@color/onButton"
          android:textSize="@dimen/smallFont" />
      </LinearLayout>

      <!-- 状态区域 -->
      <LinearLayout
        android:id="@+id/status_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@drawable/background_cron"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingEnd="15dp"
        android:paddingBottom="10dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/easytier_status"
          android:textColor="@color/onCardBackground"
          android:textSize="@dimen/middleFont" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已停止"
            android:textColor="@color/onCardBackground"
            android:textSize="@dimen/smallFont" />

          <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/background_round" />
        </LinearLayout>

        <TextView
          android:id="@+id/vpn_ip_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="@string/easytier_vpn_ip"
          android:textColor="@color/onCardBackground"
          android:textSize="@dimen/middleFont"
          android:visibility="gone" />

        <TextView
          android:id="@+id/vpn_ip_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:textColor="@color/onCardBackgroundSecond"
          android:textSize="@dimen/smallFont"
          android:visibility="gone"
          tools:text="10.0.0.1" />

        <!-- 日志区域 -->
        <TextView
          android:id="@+id/log_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:background="@drawable/background_cron_stroke"
          android:fontFamily="monospace"
          android:maxHeight="200dp"
          android:padding="8dp"
          android:textColor="@color/onCardBackgroundSecond"
          android:textSize="@dimen/smallSmallFont"
          android:visibility="gone"
          tools:text="[EasyTier] 启动中..." />

        <!-- 启动/停止按钮 -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:gravity="center"
          android:orientation="horizontal">

          <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/background_cron"
            android:backgroundTint="@color/button"
            android:gravity="center"
            android:text="@string/easytier_start"
            android:textColor="@color/onButton"
            android:textSize="@dimen/smallFont" />

          <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/background_cron"
            android:backgroundTint="@color/onCardBackgroundSecond"
            android:gravity="center"
            android:text="@string/easytier_stop"
            android:textColor="@color/cardBackground"
            android:textSize="@dimen/smallFont" />
        </LinearLayout>
      </LinearLayout>

      <!-- 底部占位 -->
      <Space
        android:layout_width="match_parent"
        android:layout_height="60dp" />

    </LinearLayout>
  </ScrollView>
</LinearLayout>
